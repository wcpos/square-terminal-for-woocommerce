<?xml version="1.0" encoding="UTF-8"?>
<!-- Pro's provider conformance suite against the real adapter under wp-env; see tests/conformance/. Run with the sibling Pro's PHPUnit 9. -->
<phpunit bootstrap="tests/conformance/bootstrap.php" colors="true" cacheResult="false">
	<testsuites>
		<testsuite name="conformance"><directory prefix="Test_" suffix=".php">tests/conformance</directory></testsuite>
	</testsuites>
</phpunit>
